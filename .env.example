# SQLite database location — MUST be an absolute path so Prisma can write to it.
# The package.json db: scripts inline this as `DATABASE_URL="$(pwd)/db/custom.db"`.
DATABASE_URL="file:/home/z/my-project/apps/17-internal-wiki-ai-search/db/custom.db"

# --- Optional LLM / embeddings env vars (all default to the deterministic in-process hashing embedder) ---
# Set EMBEDDINGS_API_KEY (or OPENAI_API_KEY) + EMBEDDINGS_BASE_URL + EMBEDDINGS_MODEL to
# use a real OpenAI-compatible embeddings endpoint (text-embedding-3-small by default).
# EMBEDDINGS_API_KEY=""
# EMBEDDINGS_BASE_URL="https://api.openai.com/v1"
# EMBEDDINGS_MODEL="text-embedding-3-small"
# OPENAI_API_KEY=""

# Set WIKI_DISABLE_LLM=1 to force the mock chat provider (useful for offline UI demos).
# WIKI_DISABLE_LLM=0
